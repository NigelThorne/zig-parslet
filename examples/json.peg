# JSON parsed by PEG, not delegated to a JSON parser.
# Inspired by NigelThorne/ElixirParslet/test/json_parser_test.exs.
# This profile requires valid UTF-8 and paired UTF-16 surrogate escapes.
root document
document <- ws value
value <- (object / array / string / number / boolean / null) ws
ws <- [ \t\r\n]*

# Empty branches require their closing delimiter, preserving deeper failures.
object <- "{" ws (json_object:members / json_empty_object:&"}") "}"
members <- member ("," ws member)*
member <- entry:(key:string ws ":" ws value:value)

array <- "[" ws (json_array:elements / json_empty_array:&"]") "]"
elements <- element ("," ws element)*
element <- element:value

string <- json_string:("\"" character* "\"")
character <- escape / [^\x00-\x1f"\\\x80-\xff] / utf8
escape <- "\\" (["\\/bfnrt] / "u" unicode_escape)
unicode_escape <- high_surrogate "\\u" low_surrogate / normal_unicode
high_surrogate <- [dD] [89aAbB] hex hex
low_surrogate <- [dD] [c-fC-F] hex hex
normal_unicode <- !([dD] [89a-fA-F]) hex hex hex hex
hex <- [0-9a-fA-F]

# UTF-8 scalar values: no stray continuations, overlong forms or surrogates.
utf8 <- [\xc2-\xdf] continuation
      / [\xe0] [\xa0-\xbf] continuation
      / [\xe1-\xec\xee-\xef] continuation continuation
      / [\xed] [\x80-\x9f] continuation
      / [\xf0] [\x90-\xbf] continuation continuation
      / [\xf1-\xf3] continuation continuation continuation
      / [\xf4] [\x80-\x8f] continuation continuation
continuation <- [\x80-\xbf]

number <- json_number:("-"? ("0" / [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?)
boolean <- json_boolean:("true" / "false")
null <- json_null:"null"

@test "empty object" { input: "{}" expect: { json_empty_object: "" } }
@test "empty array" { input: "[]" expect: { json_empty_array: "" } }
@test "quoted string" { input: "\"hello\"" expect: { json_string: "\"hello\"" } }
@test "number token" { input: "-12.50e+2" expect: { json_number: "-12.50e+2" } }
@test "singleton array" { input: "[1]" expect: { json_array: { element: { json_number: "1" } } } }
@test "singleton object" {
  input: "{\"a\":true}"
  expect: { json_object: { entry: { key: { json_string: "\"a\"" }, value: { json_boolean: "true" } } } }
}
@test "leading zero" { input: "01" reject: true }
@test "trailing comma" { input: "[1,]" reject: true }
@test "missing colon" { input: "{\"a\" 1}" reject: true }
@test "invalid escape" { input: "\"\\q\"" reject: true }
@test "unpaired surrogate" { input: "\"\\ud800\"" reject: true }
